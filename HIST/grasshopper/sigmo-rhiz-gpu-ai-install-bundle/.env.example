# RHIZ GPU AI install bundle env
PROJECT_NAME=sigmo-rhiz-gpu-ai
DOMAIN=ai.sigmo-rhiz.local
HOST_BIND=0.0.0.0
HOSTNAME_TARGET=sigmo-rhiz
HOST_LAN_IP=192.168.0.34

# Cluster endpoints
NIURK19_IP=192.168.0.49
LLAMA_GPU_IP=192.168.0.125
GPU_COMPUTE_IP=192.168.0.52
NIURK72_IP=192.168.0.72
METROLOGY_LAB_IP=192.168.0.42

# Ports
GATEWAY_PORT=8099
UI_PORT=3033
MCP_PORT=8787
COLLECTOR_PORT=8098
LLAMA_CPP_PORT=8088
VLLM_PORT=8000
DIFFUSERS_PORT=7860
DMR_PORT=12434
OLLAMA_PORT=11434
MONGO_PORT=27019
REDIS_PORT=6381

# Auth. Change these.
RHIZ_ADMIN_TOKEN=change-me-admin-token
RHIZ_GATEWAY_TOKEN=change-me-gateway-token
MONGO_INITDB_ROOT_USERNAME=rhiz
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo
MONGO_DATABASE=rhiz_ai

# Docker Model Runner
DMR_ENABLED=true
DMR_BASE_URL=http://model-runner.docker.internal:12434/engines/v1
DMR_NATIVE_URL=http://model-runner.docker.internal:12434
DMR_DEFAULT_MODEL=ai/smollm2:360M-Q4_K_M

# Providers
LLAMA_GPU_BASE_URL=http://192.168.0.125:8088/v1
GPU_COMPUTE_VLLM_BASE_URL=http://192.168.0.52:8000/v1
GPU_COMPUTE_DIFFUSERS_URL=http://192.168.0.52:7860
LOCAL_LLAMA_CPP_BASE_URL=http://llama-cpp:8088/v1
OLLAMA_BASE_URL=http://ollama:11434/v1

# Routing
DEFAULT_CHAT_MODEL=local/smollm2
DEFAULT_CODE_MODEL=glm-flash-code
DEFAULT_HEAVY_MODEL=mistral-medium-3.5-128b
DEFAULT_IMAGE_MODEL=flux-schnell
ENABLE_RISKY_MODEL_PROFILES=false
ALLOW_REMOTE_PULLS=false
ALLOW_HF_GIT_LFS_PULLS=false

# Host model dirs
MODEL_ROOT=/srv/rhiz/models
GGUF_DIR=/srv/rhiz/models/gguf
SAFETENSORS_DIR=/srv/rhiz/models/safetensors
DIFFUSERS_DIR=/srv/rhiz/models/diffusers
CACHE_DIR=/srv/rhiz/cache

# NVIDIA / Docker
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
CUDA_VISIBLE_DEVICES=0

# Swarm
SWARM_ADVERTISE_ADDR=192.168.0.34
SWARM_OVERLAY_SUBNET=10.45.70.0/24

# UI
NEXT_PUBLIC_GATEWAY_URL=http://192.168.0.34:8099
NEXT_PUBLIC_MCP_URL=http://192.168.0.34:8787
NEXT_PUBLIC_CLUSTER_LABEL=SIGMO-RHIZ GPU AI
