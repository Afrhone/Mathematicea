# Cluster placement
LXD_TARGET=exosys-rhiz
LXD_CONTAINER=arduino-iot-lab
LXD_IMAGE=ubuntu:25.04
LXD_STORAGE=rhiz-storage
LXD_PROFILE=arduino-iot-lab
LXD_NETWORK=br0
LXD_IPV4=dhcp

# API/UI ports inside the container
IOT_API_PORT=8060
IOT_UI_PORT=8061
MQTT_PORT=1883
MONGO_PORT=27017
REDIS_PORT=6379
KICAD_MCP_PORT=8070

# Host firewall allowlist
ALLOW_LAN_CIDR=192.168.0.0/24
ALLOW_MESH_CIDR=10.42.0.0/24

# Serial discovery regexes
ARDUINO_USB_MATCH=Arduino|UNO|Yun|WiFi|MKR|CH340|CP210|ACM|USB Serial
UNO_WIFI_REV2_PORT=auto
YUN_REV2_PORT=auto
ARDUINO_Q_PORT=auto
RUN_REV2_HOST=arduino-run.local
RUN_REV2_PORT=80

# I2C defaults
BME280_ADDR=0x76
BMM150_ADDR=0x10
AMG8833_ADDR=0x69
PN532_MODE=i2c
PN532_IRQ=2
PN532_RESET=3

# USB LTE/tether fallback
ENABLE_USB_TETHER_FALLBACK=false
USB_TETHER_IFACE=auto
LAN_IFACE=br0
TETHER_SHARED_CIDR=172.31.77.1/24
FORWARD_API_TO_CONTAINER=true

# Docker
COMPOSE_PROJECT_NAME=arduino_iot_lab
MONGO_INITDB_ROOT_USERNAME=arduino
MONGO_INITDB_ROOT_PASSWORD=change-me-strong
IOT_API_TOKEN=change-me-token
ADMIN_USER=phi

# KiCad MCP
KICAD_CONTAINER_IMAGE=kicad/kicad:latest
KICAD_PROJECT_ROOT=/workspace/kicad-projects
