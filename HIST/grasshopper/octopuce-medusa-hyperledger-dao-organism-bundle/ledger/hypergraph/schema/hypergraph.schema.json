{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OctopuceMedusaHypergraph",
  "type": "object",
  "required": [
    "nodes",
    "hyperedges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "hyperedges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hyperedge"
      }
    },
    "metagraph_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metagraph_edge"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "state": {
          "type": "object"
        }
      }
    },
    "hyperedge": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "sources",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proof": {
          "type": "object"
        },
        "ledger_anchor": {
          "type": "object"
        }
      }
    },
    "metagraph_edge": {
      "type": "object",
      "required": [
        "id",
        "from_edge",
        "to_edge",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from_edge": {
          "type": "string"
        },
        "to_edge": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        }
      }
    }
  }
}