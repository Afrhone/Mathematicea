[Unit]
Description=RHIZ Sinkhole Guardian API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=-/etc/rhiz-guardian/agent.env
WorkingDirectory=/opt/rhiz-guardian/api
ExecStart=/opt/rhiz-guardian/api/venv/bin/uvicorn main:app --host 0.0.0.0 --port ${GUARDIAN_API_PORT}
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
