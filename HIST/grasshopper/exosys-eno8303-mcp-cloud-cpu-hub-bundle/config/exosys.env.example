NODE_NAME=exosys-rhiz
PRIMARY_INTERFACE=eno8303
DIRECT_LINK_NAME=exosys-switchlink
DIRECT_LINK_CIDR=10.83.3.1/24
DIRECT_LINK_DNS=1.1.1.1
LABEL_SWAP_EXAMPLE=swap:exosys-rhiz:eno8303:cpu-mem-lane

ADMIN_DASHBOARD_PORT=7190
MCP_CPU_HUB_PORT=7191
GOOGLE_AGENT_GATEWAY_PORT=7192
IBM_QUANTUM_GATEWAY_PORT=7193
SUBSTACK_BRIDGE_PORT=7194
GAMELAB_ORCHESTRATOR_PORT=7195

ADMIN_TOKEN=change-me-admin
MCP_TOKEN=change-me-mcp
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-application-credentials.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_LOCATION=us-central1
GOOGLE_AGENT_ENGINE_ID=
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
SUBSTACK_PUBLICATION_URL=
SUBSTACK_SESSION_TOKEN=

DATA_ROOT=/var/lib/exosys-hub
DUMP_ROOT=/srv/exosys-dumps
SWAP_FILE=/srv/exosys-swap/swapfile
SWAP_SIZE_GB=32
CPU_QUEUE=/var/lib/exosys-hub/cpu-queue.ndjson
EVENT_SINK=/var/lib/exosys-hub/events.ndjson
TOPOLOGY_SINK=/var/lib/exosys-hub/topology.json

GAMELAB_VM_NAME=gamelab-cpu
GAMELAB_IMAGE=ubuntu:24.04
GAMELAB_CPU=12
GAMELAB_MEMORY=24GiB
GAMELAB_STORAGE=local-dir

APPLY=0
ALLOW_CLOUD_CALLS=0
ALLOW_SWAP=0
ALLOW_LXD_CREATE=0
