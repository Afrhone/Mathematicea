CLUSTER_NAME=rhiz-ai
PRIMARY_MODEL_HOST=192.168.0.125
GPU_COMPUTE_HOST=192.168.0.52
SIGMO_HOST=sigmo-rhiz
SIGMO_IP=192.168.0.34
APP_ALLOWED_CIDR=192.168.0.0/24

LLAMA_CPP_PORT=8080
MODEL_GATEWAY_PORT=7181
MCP_PORT=7182
OPEN_WEBUI_PORT=3000
DIFFUSERS_PORT=7860
VLLM_PORT=8000

MODEL_ROOT=/srv/models
GGUF_ROOT=/srv/models/gguf
SAFETENSORS_ROOT=/srv/models/safetensors
HF_HOME=/srv/models/.cache/huggingface

LLAMA_CPP_IMAGE=ghcr.io/ggerganov/llama.cpp:server
K5000_MODE=legacy
ENABLE_NVIDIA_INSTALL=0
ENABLE_NVIDIA_CONTAINER_TOOLKIT=1
ENABLE_VLLM=0
ENABLE_DIFFUSERS=0
ENABLE_DOCKER_MODEL_RUNNER=0

ALLOW_UNSAFE_MODELS=0
ALLOW_PUBLIC_BIND=0
