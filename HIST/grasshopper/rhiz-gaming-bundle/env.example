# ============================================
# Rhiz Cascade Orchestrator — env.example
# Fedora hosts + Ubuntu guests + Ceph + libvirt + LXD + Swarm
# ============================================

SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_STRICT_HOSTKEY=accept-new
INVENTORY_FILE=directives/hosts.yaml
ARCHITECTURE_FILE=directives/architecture.yaml
PUBLIC_GATEWAY_FILE=directives/public-gateway.yaml
LIBVIRT_STORAGE_FILE=directives/libvirt-storage.yaml
VM_PROFILES_FILE=directives/vm-profiles.yaml
VM_GUESTS_FILE=directives/vm-guests.yaml
LXD_CLUSTER_FILE=directives/lxd-cluster.yaml
DOCKER_SWARM_FILE=directives/docker-swarm.yaml
SERVICE_CARDS_FILE=directives/service-cards.yaml
GUEST_BOOTSTRAP_FILE=directives/guest-bootstrap.yaml
APP_GATEWAY_FILE=directives/app-gateway.yaml
SSO_FILE=directives/sso.yaml
DNS_UI_FILE=directives/dns-ui.yaml
COMPUTE_POOLS_FILE=directives/compute-pools.yaml
GENERATED_DIR=generated
LOCAL_HOST_NAME=rhiz-loes

HOST_PROFILE_APPLY_HOSTNAME=yes
HOST_PROFILE_RENDER_ENV=.env.host
REMOTE_TRANSPORT=auto
REMOTE_USE_SSH_CONFIG=yes
REMOTE_BUNDLE_DIR=~/rhiz-bundle
INTERACTIVE_DEFAULT_YES=yes

WG_CEPH_IF=ceph-operator
WG_CEPH_PRIVATE_KEY_FILE=/etc/wireguard/ceph-operator.key
WG_CEPH_DIRECTIVE_FILE=directives/wg-ceph-operator.rhiz-loes.yaml
WG_PEER_KEEPALIVE=25
VPN_CONTROL_CIDR=10.42.0.0/24
VPN_OPERATOR_CIDR=10.44.50.0/24
VPN_BASTION_CIDR=10.44.99.0/24

CEPH_RELEASE=squid
CEPH_CLUSTER_NAME=ceph
CEPH_IMAGE=
CEPH_PUBLIC_NETWORK=10.42.0.0/24
CEPH_CLUSTER_NETWORK=10.42.0.0/24
CEPH_BOOTSTRAP_MON_IP=10.42.0.38
CEPH_MON_HOSTS=rhiz-loes,rhiz-ueth,rhiz-woute,factau-rhiz
CEPH_MGR_HOSTS=rhiz-loes,rhiz-ueth
CEPH_ADMIN_HOSTS=rhiz-loes,rhiz-ueth
CEPH_SSH_USER=root
CEPH_HOST_PREP_MODE=inventory-user
CEPH_HOST_PREP_SUDOERS=yes
CEPH_HOST_PREP_ALLOW_INTERACTIVE_SUDO=no
CEPH_ENFORCE_INVENTORY_HOSTNAME=yes
CEPH_SKIP_MONITORING_STACK=yes
CEPH_DASHBOARD_USER=admin
CEPH_DASHBOARD_PASSWORD=
CEPH_POOL=vms
CEPH_POOL_APPLICATION=rbd
CEPH_POOL_PG_NUM=64
CEPH_POOL_REPLICA_SIZE=3
CEPH_POOL_MIN_SIZE=2
CEPH_POOL_AUTOSCALE_MODE=on
CEPH_IMAGE_DEFAULT_SIZE=60G
CEPH_OSD_DEVICES=
CEPH_OSD_SPEC_FILE=directives/osd-spec.yaml
I_UNDERSTAND_DISK_WILL_BE_WIPED=no

LIBVIRT_DEFAULT_URI=qemu:///system
LIBVIRT_CEPH_SECRET_NAME=ceph-libvirt-client
LIBVIRT_CEPH_SECRET_UUID=11111111-2222-3333-4444-555555555555
LIBVIRT_STORAGE_DEFINE_AUTOSTART=yes
LIBVIRT_CPUSET_RESERVED=0-1
LIBVIRT_GPU_DRIVER=vfio-pci
LIBVIRT_MIGRATE_PEER2PEER=yes
VM_NETWORK_BRIDGE=br0
VM_OS_VARIANT=ubuntu24.04
VM_VCPUS=4
VM_RAM_MB=8192
VM_DISK_SIZE=60G
VM_DEFAULT_CLOUD_IMAGE=
VM_SEED_DIR=/var/lib/libvirt/images/seed
VM_GUEST_USER=ubuntu
VM_SSH_PUBKEY_FILE=
VM_POOL=vms
VM_IMAGE_POOL=images
VM_BACKUP_POOL=backups
DUMPS_DIR=/srv/uniphilab/dumps

UBUNTU_GUEST_RELEASE=24.04
LXD_USE_SNAP=yes
LXD_CLUSTER_PROJECT=rhiz
LXD_CLUSTER_TARGET_GROUP=cpu
LXD_CPU_POOL_STORAGE=ceph-rbd
LXD_GPU_POOL_STORAGE=ceph-rbd
LXD_SHARED_FS_POOL=cephfs-shared
SWARM_DEFAULT_STACK=management-ui
SWARM_ADVERTISE_IFACE=eth0
SWARM_MANAGER_LABEL=swarm-manager
SWARM_WORKER_LABEL=swarm-worker
DOCKER_REGISTRY_MIRROR=

GATEWAY_ENABLE=yes
GATEWAY_CONFIGURE_IP_FORWARD=yes
GATEWAY_ENABLE_MASQUERADE=yes
GATEWAY_PUBLIC_ZONE=public
GATEWAY_VPN_ZONE=trusted
GATEWAY_ALLOW_SSH=yes
GATEWAY_ALLOW_WIREGUARD=yes
GATEWAY_FORWARD_PORTS=tcp:443:10.42.0.33:443,tcp:8443:10.42.0.38:8443,tcp:16509:10.42.0.38:16509
PUBLIC_ENDPOINT=rhiz-arch.afrho.net
PUBLIC_WILDCARD_DOMAIN=*.rhiz-arch.afrho.net
REMOTE_CONFIG_CALLBACK=https://rhiz-arch.afrho.net/api/enroll
ENROLLMENT_TOKEN_TTL_HOURS=24
SSO_PROVIDER=authelia
DNS_UI_PROVIDER=technitium
NOMULUS_MODE=stub

CPU_POOL_LABEL=pool-cpu
GPU_POOL_LABEL=pool-gpu
VM_POOL_LABEL=pool-vm
LXD_CPU_GROUP=lxd-cpu
LXD_GPU_GROUP=lxd-gpu
SWARM_MANAGER_GROUP=swarm-managers
SWARM_WORKER_GROUP=swarm-workers

# Windows gaming VM / Xbox integration
WINDOWS_GAMING_FILE=directives/gaming-vm.yaml
XBOX_INTEGRATION_FILE=directives/xbox-integration.yaml
WINDOWS_ISO_PATH=/srv/isos/Win11_24H2_English_x64.iso
VIRTIO_WIN_ISO_PATH=/srv/isos/virtio-win.iso
WIN_OVMF_CODE=
WIN_OVMF_VARS_TEMPLATE=
WIN_GUEST_NAME=valkyrie-win11
WIN_GUEST_PROFILE=win11-gaming
WIN_GUEST_OS_VARIANT=win11
WIN_GUEST_HOST=sigmo-rhiz
WIN_GUEST_POOL=vms
WIN_GUEST_RBD_IMAGE=valkyrie-win11-os
WIN_GUEST_VCPUS=12
WIN_GUEST_RAM_MB=32768
WIN_GUEST_DISK_SIZE=220G
WIN_GUEST_BRIDGE=br0
WIN_GUEST_GPU_VIDEO_BDF=0000:0f:00.0
WIN_GUEST_GPU_AUDIO_BDF=0000:0f:00.1
WIN_VM_MACHINE=q35
WIN_VM_ENABLE_SECURE_BOOT=yes
WIN_VM_ENABLE_TPM=yes
WIN_VM_ENABLE_HYPERV=yes
WIN_VM_VIDEO_FALLBACK=virtio
WIN_VM_SPICE_LISTEN=127.0.0.1
WIN_VM_START_AFTER_DEFINE=no
WIN_VM_CPU_MODE=host-passthrough
WIN_VM_CPUSET=
WIN_VM_EMULATORPIN=
WIN_VM_IOTHREADPIN=
WIN_VM_NETWORK_MODEL=virtio
WIN_VM_VIRTIO_DISK_BUS=virtio
CEPH_RBD_MON_HOSTS=10.42.0.38:6789
LIBVIRT_CEPH_AUTH_USER=libvirt
SUNSHINE_INSTALL_METHOD=winget
SUNSHINE_ALLOWED_CIDRS=10.42.0.0/24,10.44.0.0/16,192.168.0.0/24
SUNSHINE_WEB_UI_PORT=47990
SUNSHINE_FPS=120
SUNSHINE_ENABLE_HDR=no
XBOX_ONE_CLIENT_NAME=local-xbox-one
XBOX_ONE_CLIENT_MODE=moonlight-retail
XBOX_ONE_ENABLE_EDGE_XCLOUD=yes
XBOX_ONE_ENABLE_REMOTE_PLAY=yes
