# Namespace / identity
NAMESPACE=factory-rhizome-lab-studio
TRIBE="Cyberphunk Dystopian Afrhône Tribe"
NODE_NAME=rhiz-fach
LAB_NAME=metrology-lab
BADGE=YETI-715

# Handshake
HANDSHAKE_PHRASE="YETI gates the stem, Raven tastes sweet, axiom before retry, rhizome remembers, entropy bows to proof."
HANDSHAKE_SHA256=17ecf51f7114c52a384d0d048165459159688e74aeaaf745cafa683bfefebea1
GATEWAY_TOKEN_FILE=/etc/rhizome/gateway.token
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=7150
OUTPOST_URL=http://127.0.0.1:7150

# LXD
LXD_IMAGE=ubuntu:24.04
LXD_STORAGE=rhiz-storage
LXD_CPU=10
LXD_MEMORY=12GiB

# Ceph/RBD
CEPH_CLUSTER=ceph
CEPH_CLIENT=lxd
CEPH_POOL=lxd-rbd-ark
CEPH_CONF=/etc/ceph/ceph.conf
CEPH_KEYRING=/etc/ceph/ceph.client.lxd.keyring

# Data sinks
DATA_ROOT=/var/lib/rhizome-metrology
EVENT_SINK=/var/lib/rhizome-metrology/events.ndjson
STATE_SINK=/var/lib/rhizome-metrology/state.ndjson
GRAPH_SINK=/var/lib/rhizome-metrology/graph.ndjson
METRIC_SINK=/var/lib/rhizome-metrology/metrics.prom

# API flags
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5-thinking

# Gates
MAX_STATE_ENTROPY=0.72
MAX_ASYMMETRY_SCORE=0.40
MAX_DRIFT_SCORE=0.35
APPLY=0
ALLOW_DESTRUCTIVE=0
SKIP_GATES=0
