# AFRHO VR/AR Functor Lab
PROJECT_NAME=afrho-vr-ar-functor-lab
DOMAIN=afrho.net
PUBLIC_BASE_URL=http://localhost:8077
API_BASE_URL=http://localhost:8078

# Bootstrap admin - replace immediately
BOOTSTRAP_ADMIN_USER=phi
BOOTSTRAP_ADMIN_PASSWORD=change-me-do-not-commit
BOOTSTRAP_ADMIN_EMAIL=phi@afrho.net

# Auth
JWT_SECRET=replace-with-openssl-rand-hex-32
WHITELIST_MODE=true
ALLOW_VIBE_CODING_PLAYGROUND=false

# Database
MONGO_URL=mongodb://mongo:27017/afrho_vr_ar
REDIS_URL=redis://redis:6379/0

# Agent gateway
AGENT_BASE_URL=http://agent-gateway:8080/v1
LOCAL_LLM_BASE_URL=http://llama-gpu:8080/v1
LOCAL_LLM_MODEL=llama-gpu-default
KOBALT_SIGMA_PERSONA=config/persona.kobalt-sigma.md

# LimeSDR / SDR
SDR_MODE=synthetic
LIMESDR_LXD_TARGET=factau-rhiz
LIMESDR_HOST_IP=192.168.0.4
LIMESDR_SAMPLE_RATE=2000000
LIMESDR_CENTER_FREQ=1420000000
LIMESDR_GAIN=30

# EEG / OSC
EEG_MODE=synthetic
EEG_OSC_PORT=9001
EEG_WS_PATH=/ws/eeg

# WebGL
WEBGL_DIMENSIONS=12
WEBGL_PROJECTION=hypersphere
WEBGL_PARTICLE_COUNT=12000
WEBGL_ENABLE_VR=false
WEBGL_ENABLE_AR=false
