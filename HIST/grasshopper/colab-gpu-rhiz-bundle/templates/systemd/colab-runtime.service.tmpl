[Unit]
Description=Colab local runtime container
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/start-colab-runtime.sh
ExecStop=/usr/bin/docker stop colab-runtime
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
