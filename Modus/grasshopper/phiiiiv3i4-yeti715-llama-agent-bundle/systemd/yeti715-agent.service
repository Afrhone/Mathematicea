[Unit]
Description=phiiiiv3i4 YETI-715 Agent API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/phiiiiv3i4-yeti715-agent
EnvironmentFile=-/opt/phiiiiv3i4-yeti715-agent/.env
ExecStart=/usr/bin/docker compose up --build
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
