# Persona
PERSONA_ID=phiiiiv3i4
PERSONA_PROFILE=persona/phiiiiv3i4.profile.json
SYSTEM_PROMPT=prompts/yeti715_system.md
SUMMON_PHRASE="phiiiiv3i4 opens the rhizome; YETI gates the stem; Raven tastes sweet; proof before retry."
SUMMON_SHA256=64f92914b7aa9987e75e090b46d8d1fb6ca2c582f9d5cf415310697f6e3c65cb

# Agent API
AGENT_BIND=0.0.0.0
AGENT_PORT=7175
AGENT_DATA_ROOT=/var/lib/yeti715-agent
AGENT_EVENT_SINK=/var/lib/yeti715-agent/events.ndjson

# Llama compatible backend
# llama.cpp server usually exposes OpenAI-compatible endpoints under /v1.
LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_MODEL=local-model
LLAMA_API_KEY=local-not-needed

# Ollama optional
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=yeti715

# Behavior flags
REQUIRE_SUMMON=1
ALLOW_EXTERNAL_CALLS=0
ALLOW_CLUSTER_MUTATION=0
GATE_BEFORE_RETRY=1

# LXD optional
LXD_IMAGE=ubuntu:24.04
LXD_STORAGE=rhiz-storage
LXD_NAME=yeti715-agent
LXD_CPU=4
LXD_MEMORY=8GiB
APPLY=0
