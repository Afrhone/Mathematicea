# Core server
APP_HOST=0.0.0.0
APP_PORT=8098
PUBLIC_BASE_URL=http://192.168.0.49:8098
LAB_NAME=iphone-xr-limesdr-observatory

# Network allowlist
ALLOW_ORIGINS=http://localhost:8098,http://192.168.0.49:8098,http://192.168.0.52:8098,http://192.168.0.125:8098
PHONE_SHARED_TOKEN=change-me-phone-token
MCP_SHARED_TOKEN=change-me-mcp-token

# Video ingest
VIDEO_SOURCE=phone_ws
# For external camera apps use e.g. rtsp://iphone.local:8554/live or http://iphone/live.m3u8
VIDEO_INGEST_URL=
VIDEO_FRAME_WIDTH=1280
VIDEO_FRAME_HEIGHT=720
VIDEO_FPS=10

# Astronomy/lens defaults for iPhone XR rear wide camera approximation
# Override after calibration.
LENS_FOCAL_LENGTH_MM=4.25
SENSOR_WIDTH_MM=5.60
SENSOR_HEIGHT_MM=4.20
IMAGE_WIDTH_PX=4032
IMAGE_HEIGHT_PX=3024
TELESCOPE_FOCAL_LENGTH_MM=500
TELESCOPE_APERTURE_MM=80

# LimeSDR / SoapySDR
SDR_DEVICE=driver=lime
SDR_SAMPLE_RATE=2000000
SDR_CENTER_FREQ=1420405751
SDR_BANDWIDTH=1500000
SDR_GAIN=30
SDR_SYNTHETIC=true
SPECTROGRAM_FFT_SIZE=2048
SPECTROGRAM_HISTORY=256

# Feedback loop
ENABLE_AUDIO_FEEDBACK=false
ENABLE_POINTING_FEEDBACK=true
FEEDBACK_RATE_HZ=2

# Optional local agent gateways
LOCAL_MODEL_BASE_URL=http://192.168.0.125:8080/v1
GPU_COMPUTE_BASE_URL=http://192.168.0.52:8080/v1
OPENAI_COMPAT_MODEL=local-observatory-agent
