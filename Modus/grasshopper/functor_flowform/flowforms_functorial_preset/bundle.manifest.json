{
  "name": "flowforms_functorial_preset_bundle",
  "version": "2.0.0-functorial",
  "includes": [
    "HTML5 Canvas/SVG playground",
    "Functorial Alphabet preset",
    "graph\u00e8me\u2192phon\u00e8me mappings",
    "ODE/Lagrangian formalization",
    "CMS/API preset endpoints",
