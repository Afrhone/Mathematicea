      "icon": "\u2228",
      "axiom": "Primary structures, openings, vessels."
    },
    "rhythm": {
      "label": "Rhythm",
      "functor": "\u03a9: repetition \u21a6 oscillatory path",
      "icon": "\u3030",
      "axiom": "Pulses, sweeps, recurrence."
    },
    "nature": {
      "label": "Nature",
      "functor": "N: node \u21a6 branch growth",
      "icon": "\u03c8",
      "axiom": "Growth, branches, organic balance."
