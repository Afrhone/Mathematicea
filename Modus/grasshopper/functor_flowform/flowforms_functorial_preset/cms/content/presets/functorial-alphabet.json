      "read",
      "voice",
      "gesture",
      "sample",
      "differentiate",
      "integrate",
      "morph",
      "export"
    ],
    "functor": "\u03a6 : Graph\u00e8mePhon\u00e8me \u2192 BezierODE",
    "naturalTransformations": [
      "\u03b7_root: identity \u2192 anchored trace",
      "\u03bc_momentum: path \u2192 time-evolved path",
      "\u03c1_rhythm: path \u2192 periodic path"
    ]
  },
  "realFunction": "F_\u03b8(s;g,p,a)=A_\u03b8(\u03a3_i B_i(s)P_i(g)+\u03a6_root(s,g)+\u03a6_rhythm(s,p)+\u03a6_axiom(s,a))",
  "lagrangian": "L(q,qdot,t)=1/2 qdot^T M qdot - V_root(q,g)-V_smooth(q)-V_phoneme(q,p)-V_family(q)+A_momentum(q,t)\u00b7qdot",
  "ode": "M qddot + C qdot + \u2207V(q,t) - B(q,t)qdot = u_g(t)",
