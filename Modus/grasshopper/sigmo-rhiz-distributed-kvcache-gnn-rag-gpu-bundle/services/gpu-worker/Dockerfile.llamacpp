FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y git build-essential cmake curl ca-certificates python3 python3-pip jq s3cmd && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
RUN git clone --depth=1 https://github.com/ggml-org/llama.cpp.git
WORKDIR /opt/llama.cpp
RUN cmake -B build -DGGML_NATIVE=ON -DGGML_CUDA=OFF && cmake --build build -j"$(nproc)"
COPY worker-entrypoint.sh /worker-entrypoint.sh
RUN chmod +x /worker-entrypoint.sh
VOLUME ["/models","/state"]
EXPOSE 8080
ENTRYPOINT ["/worker-entrypoint.sh"]
