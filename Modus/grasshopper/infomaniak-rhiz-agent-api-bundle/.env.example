# Public domain / UI
PUBLIC_DOMAIN=outpost.aheap.afrho.net
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8066
NEXT_PUBLIC_WS_URL=ws://localhost:8066/ws/telemetry

# Gateway auth
GATEWAY_API_KEY=change-me-local-gateway-key
GATEWAY_REQUIRE_AUTH=true

# Mongo / queue
MONGO_URI=mongodb://mongo:27017/rhiz_agent
REDIS_URL=redis://redis:6379/0

# Infomaniak AI Tools
INFOMANIAK_BASE_URL=https://api.infomaniak.com/2/ai
INFOMANIAK_PRODUCT_ID=000000
INFOMANIAK_API_KEY=ik-change-me
INFOMANIAK_TIMEOUT_SECONDS=180
INFOMANIAK_ENABLE=true

# Local-first providers. Comma-separated OpenAI-compatible base URLs.
LOCAL_OPENAI_ENDPOINTS=http://ollama:11434/v1,http://llama-cpp:8080/v1
LOCAL_OPENAI_MODELS=llama-local-fast,llama-local-coder,llama-local-rag
OLLAMA_BASE_URL=http://ollama:11434
LLAMA_CPP_BASE_URL=http://llama-cpp:8080/v1

# Routing thresholds
LOCAL_FIRST=true
LOCAL_MAX_INPUT_TOKENS=24000
CLOUD_HEAVY_MIN_TOKENS=24000
PARALLEL_REVIEW_MAX_WORKERS=6

# Default model aliases
MODEL_FAST=mistralai/Ministral-3-14B-Instruct-2512
MODEL_HEAVY=Qwen/Qwen3.5-122B-A10B-FP8
MODEL_SOVEREIGN=Apertus-70B-Instruct-2509
MODEL_CODE=moonshotai/Kimi-K2.6
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
MODEL_MISTRAL_LARGE=mistralai/Mistral-Small-4-119B-2603
MODEL_RERANK=BAAI/bge-reranker-v2-m3
MODEL_RERANK_FAST=Qwen/Qwen3-Reranker-0.6B
MODEL_EMBED_SMALL=All MiniLM L12 v2
MODEL_EMBED_LARGE=Qwen/Qwen3-Embedding-8B
MODEL_IMAGE=Flux schnell
MODEL_PHOTOMAKER=Photomaker V2

# Agent CLI integration
AGENT_WORKDIR=/workspace
GEMINI_API_KEY=optional
OPENAI_API_KEY=optional-for-codex-or-remote
CODEX_HOME=/workspace/.codex
GEMINI_HOME=/workspace/.gemini
OPEN_TERMINAL_API_KEY=change-me-terminal-key

# Caddy / TLS
CADDY_EMAIL=admin@aheap.afrho.net
UPSTREAM_UI=http://web:3000
UPSTREAM_GATEWAY=http://gateway:8066
UPSTREAM_WEBUI=http://open-webui:8080

# LXD / host observation: keep read-only unless you know why
ENABLE_HOST_COLLECTOR=false
LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
DOCKER_SOCKET=/var/run/docker.sock
