# Identity
NAMESPACE=factory-rhizome-lab-studio
LAB_NAME=reality-lab
TRIBE="Cyberphunk Dystopian Afrhône Tribe"
BADGE=YETI-715

# Handshake
HANDSHAKE_PHRASE="YETI gates the stem, Raven tastes sweet, axiom before retry, rhizome remembers, entropy bows to proof."
HANDSHAKE_SHA256=17ecf51f7114c52a384d0d048165459159688e74aeaaf745cafa683bfefebea1

# Gateway
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=7150
WEBXR_PORT=5173
ONLY_EXTERNAL_INGRESS=1
OUTPOST_URL=http://127.0.0.1:7150

# LXD cluster target
LXD_IMAGE=ubuntu:24.04
LXD_STORAGE=rhiz-storage
LXD_CPU=12
LXD_MEMORY=16GiB

# EEG
EEG_MODE=mock
EEG_SERIAL_PORT=/dev/ttyUSB0
EEG_SAMPLE_RATE=250
EEG_CHANNELS=8
EEG_SINK=/var/lib/reality-lab/eeg.ndjson

# Simulation
SIM_TAU_THRESHOLD=0.82
SIM_CRASHTEST_EPOCHS=64
SIM_POLYFRACTAL_DEPTH=7
SIM_TIMESTEP=0.016
SIM_SINK=/var/lib/reality-lab/sim.ndjson

# API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5-thinking

# Security
APPLY=0
ALLOW_EXTERNAL_POST=0
ALLOW_HARDWARE_WRITE=0
