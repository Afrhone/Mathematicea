[Unit]
Description=RHIZ Sinkhole Guardian Compose Stack
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/rhiz-sinkhole-guardian-bundle
ExecStart=/usr/bin/docker compose -f compose/docker-compose.yml --env-file .env up -d
ExecStop=/usr/bin/docker compose -f compose/docker-compose.yml --env-file .env down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
