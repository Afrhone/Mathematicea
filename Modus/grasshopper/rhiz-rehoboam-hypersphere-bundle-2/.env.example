# RHIZ Rehoboam Hypersphere runtime environment
# Safe local defaults. Replace tokens/URLs for production.

# ---- MongoDB ----
MONGO_INITDB_DATABASE=rhiz_rehoboam
MONGO_URL=mongodb://mongo:27017/rhiz_rehoboam

# ---- Web / Next.js ----
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_NAME=RHIZ Rehoboam Hypersphere
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
# Server-side gateway URL used by Next route handlers inside Docker.
GATEWAY_URL=http://gateway:8787

# ---- Gateway ----
GATEWAY_PORT=8787
CORS_ORIGIN=http://localhost:3000
COLLECTOR_TOKEN=change-me-rhiz-local
PERSONA_FILE=/app/personas/uniphilabs.persona.json

# ---- OpenAI-compatible local model backend ----
# llama.cpp CUDA profile default:
OPENAI_BASE_URL=http://llama-cpp:8080/v1
OPENAI_API_KEY=local-rhiz
MODEL_DEFAULT=local-llama-gpu

# Alternative examples:
# OPENAI_BASE_URL=http://ollama:11434/v1
# MODEL_DEFAULT=llama3.1:8b
# OPENAI_BASE_URL=http://gpu-compute:8000/v1
# MODEL_DEFAULT=/models/model.gguf

# ---- Collector / live telemetry ----
RHIZ_ROLE=host
COLLECTOR_INTERVAL=10
# Use from a remote host collector:
# GATEWAY_URL=http://<gateway-host-or-lan-ip>:8787

# ---- Optional GPU/model paths ----
MODEL_DIR=/srv/models
LLAMA_MODEL=/models/model.gguf
OLLAMA_MODELS=/root/.ollama
