{
  "name": "rhiz-rehoboam-hypersphere",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter gateway dev",
